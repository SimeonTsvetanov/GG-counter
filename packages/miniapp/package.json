{
  "name": "gg-counter-miniapp",
  "version": "1.2.5",
  "private": true,
  "description": "GG Counter's game screen behind the Quizzard mini-app contract; mounted by this repo's app/ and by Quizzard (#/scores).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./miniapp.d.ts",
      "default": "./src/index.ts"
    },
    "./module": "./src/module.ts",
    "./contract": "./src/contract.ts",
    "./meta": "./src/meta.ts",
    "./help": "./src/help.ts",
    "./help/en": "./src/help/en.ts",
    "./help/bg": "./src/help/bg.ts",
    "./host-api": "./src/host-api.ts",
    "./vite-preset": "./vite-preset.ts",
    "./styles/body.css": "./src/styles/body.css",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/en": "./src/i18n/en.ts",
    "./i18n/bg": "./src/i18n/bg.ts",
    "./storage/*": "./src/storage/*.ts",
    "./components/ui/portal-container": "./src/components/ui/portal-container.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./hooks/use-in-view": "./src/hooks/use-in-view.ts",
    "./lib/*": "./src/lib/*.ts",
    "./test/fake-storage": "./test/storage/fake-storage.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.0",
    "gg-counter-core": "workspace:*",
    "i18next": "26.7.2",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "tailwindcss": "4.3.5"
  }
}
