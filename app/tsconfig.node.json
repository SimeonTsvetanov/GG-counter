{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../.tsbuild/app-node",
    "rootDir": "..",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "../app.config.ts", "../scripts/seo.ts", "../scripts/static-page.ts"]
}
