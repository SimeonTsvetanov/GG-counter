{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/tools",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["playwright.config.ts", "vitest.config.ts", "app.config.ts", "scripts/**/*.ts", "tests/**/*.ts", "packages/*/test/**/*.ts"],
  "references": [{ "path": "./packages/core" }]
}
