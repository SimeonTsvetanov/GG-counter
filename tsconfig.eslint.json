  "compilerOptions": { "noEmit": true, "types": ["node"], "allowImportingTsExtensions": true },
  "include": ["app/src", "app/test", "app/*.ts", "packages/*/src", "packages/*/test", "packages/*/*.ts", "scripts", "tests", "*.ts"],
