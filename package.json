{
  "name": "gg-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "og-image": "node scripts/og-image.ts",
    "dev": "pnpm generate && pnpm -F gg-counter-app dev",
    "build": "pnpm generate && tsc -b && pnpm -r build",
    "preview": "pnpm -F gg-counter-app preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage && node --test scripts/*.test.mjs",
    "e2e": "playwright test",
    "docs:check": "node scripts/check-docs.ts",
    "docs:images": "pnpm build && playwright test -c playwright.docs.config.ts --pass-with-no-tests",
    "verify": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
