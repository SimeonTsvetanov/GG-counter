{
  "name": "gg-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F gg-counter-app dev",
    "build": "tsc -b && pnpm -r build",
    "preview": "pnpm -F gg-counter-app preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.73.0"
  }
}
